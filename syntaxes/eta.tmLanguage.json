{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "text.html.eta",
  "patterns": [
    {
      "include": "#eta-tags"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "eta-tags": {
      "patterns": [
        {
          "include": "#eta-expression-raw-double"
        },
        {
          "include": "#eta-expression-escaped"
        },
        {
          "include": "#eta-expression-raw"
        },
        {
          "include": "#eta-script"
        }
      ]
    },
    "eta-expression-raw-double": {
      "name": "meta.embedded.block.javascript.eta.expression.raw.double",
      "begin": "(<<%)(~)([-_]?)",
      "end": "([-_]?)(%>)",
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.eta"
        },
        "2": {
          "name": "keyword.operator.output.raw.eta"
        },
        "3": {
          "name": "keyword.control.whitespace.trim.eta"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.whitespace.trim.eta"
        },
        "2": {
          "name": "punctuation.section.embedded.end.eta"
        }
      }
    },
    "eta-expression-escaped": {
      "name": "meta.embedded.block.javascript.eta.expression.escaped",
      "begin": "(<%)(=)([-_]?)",
      "end": "([-_]?)(%>)",
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.eta"
        },
        "2": {
          "name": "keyword.operator.output.escaped.eta"
        },
        "3": {
          "name": "keyword.control.whitespace.trim.eta"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.whitespace.trim.eta"
        },
        "2": {
          "name": "punctuation.section.embedded.end.eta"
        }
      }
    },
    "eta-expression-raw": {
      "name": "meta.embedded.block.javascript.eta.expression.raw",
      "begin": "(<%)(~)([-_]?)",
      "end": "([-_]?)(%>)",
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.eta"
        },
        "2": {
          "name": "keyword.operator.output.raw.eta"
        },
        "3": {
          "name": "keyword.control.whitespace.trim.eta"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.whitespace.trim.eta"
        },
        "2": {
          "name": "punctuation.section.embedded.end.eta"
        }
      }
    },
    "eta-script": {
      "name": "meta.embedded.block.javascript.eta.script",
      "begin": "(<%)([-_]?)(?![=~])",
      "end": "([-_]?)(%>)",
      "contentName": "meta.embedded.block.javascript",
      "patterns": [
        {
          "include": "source.js"
        }
      ],
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.eta"
        },
        "2": {
          "name": "keyword.control.whitespace.trim.eta"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.whitespace.trim.eta"
        },
        "2": {
          "name": "punctuation.section.embedded.end.eta"
        }
      }
    }
  }
}
