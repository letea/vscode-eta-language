{
    "name": "vscode-eta-language",
    "displayName": "Eta Template Language for VS Code & Cursor",
    "description": "Syntax highlighting and language support for .eta (Eta template) files",
    "version": "0.1.0",
    "author": "letea",
    "publisher": "letea",
    "repository": {
        "type": "git",
        "url": "https://github.com/letea/vscode-eta-language.git"
    },
    "icon": "images/icon.png",
    "engines": {
        "vscode": "^1.60.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:eta",
        "onCommand:eta.formatDocument",
        "onCommand:eta.debugBlockComment"
    ],
    "categories": [
        "Programming Languages"
    ],
    "scripts": {
        "package": "vsce package",
        "publish": "vsce publish",
        "publish:openvsx": "npx ovsx publish -p $OVSX_PAT"
    },
    "contributes": {
        "languages": [
            {
                "id": "eta",
                "extensions": [
                    ".eta"
                ],
                "aliases": [
                    "Eta",
                    "HTML Template"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./images/eta-file-light.png",
                    "dark": "./images/eta-file-dark.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "eta",
                "scopeName": "text.html.eta",
                "path": "./syntaxes/eta.tmLanguage.json",
                "embeddedLanguages": {
                    "meta.embedded.block.javascript": "javascript"
                }
            },
            {
                "scopeName": "text.html.eta.injection",
                "path": "./syntaxes/eta.injection.tmLanguage.json",
                "injectTo": [
                    "text.html.eta"
                ]
            }
        ],
        "commands": [
            {
                "command": "eta.formatDocument",
                "title": "Eta: Format Document"
            },
            {
                "command": "eta.debugBlockComment",
                "title": "Eta: Debug Block Comment"
            }
        ],
        "keybindings": [
            {
                "key": "cmd+/",
                "command": "eta.debugBlockComment",
                "when": "editorTextFocus && editorLangId == eta"
            }
        ],
        "configuration": {
            "title": "Eta Formatter",
            "properties": {
                "eta.formatter.indentSize": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 8,
                    "description": "Fallback indentation size for Eta formatter when editor tab size is unavailable."
                }
            }
        },
        "snippets": [
            {
                "language": "eta",
                "path": "./snippets/eta.code-snippets"
            }
        ]
    },
    "license": "MIT"
}